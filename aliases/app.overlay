/ {
    aliases {
        sensor-uart = &uart4;
    };
};

&pinctrl {
    uart4_tx_pc10: uart4_tx_pc10 {
        pinmux = <0x82a>;
        bias-pull-up;
    };
    uart4_rx_pc11: uart4_rx_pc11 {
        pinmux = <0x82b>;
    };
};

&uart4 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart4_tx_pc10 &uart4_rx_pc11>;
    pinctrl-names = "default";
};
